# Dependencies
node_modules/

# Build / bundler output
dist/
build/*
!build/installer.nsh
release/
.vite/
*.asar

# More packaging output. `build/*` above has a slash in it, so it is anchored to
# the repo root and does NOT cover juce-backend/build — which holds the fetched
# JUCE 8 tree and its artefacts (742 MB). These four total ~3.1 GB:
dist-build/
dist-standalone/
juce-backend/build/

# Steinberg ASIO SDK, vendored locally so the build does not depend on a folder
# in Downloads. NOT committed: it is licensed third-party code with
# redistribution terms (see asiosdk/common/LICENSE.txt), and this repo is public
# and ships under a commercial EULA. Anyone rebuilding fetches their own copy and
# points at it with -DASIO_SDK_DIR.
juce-backend/asiosdk/

# Lyricist/ is a SEPARATE GIT REPOSITORY checked out inside this one (it has its
# own .git, plus Lyricist-release/ at 1.3 GB and lyric-core/). Committing it would
# silently record a gitlink rather than files. Ignored here until someone decides
# deliberately whether it should be a real submodule.
Lyricist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets — never commit API keys
.env
.env.*
*.local
# ...except the template, which holds no secrets and is the only place the
# build flags (Ghost Pilot gate, PostHog keys) are documented. Without this
# exception `.env.*` above swallows it and the documentation never ships.
!.env.example

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local tooling
.claude/

# Generated at build time by scripts/copy-onnx-runtime.mjs (21 MB of
# WebAssembly). npm install regenerates it, so it does not belong in history:
# every runtime bump would add another copy.
public/ort/

# Temporary / sync cruft
.tmp.*

# The Ghost voice model, ~94 MB, fetched by scripts/fetch-ghost-voice-model.mjs
# on postinstall and before every build. Not history.
public/kokoro/

