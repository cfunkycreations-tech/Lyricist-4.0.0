{
  "name": "lyricist",
  "version": "4.1.3",
  "main": "main.js",
  "description": "AI Songwriting Studio — Lyricist 4.1.3",
  "author": "CFunky Creations LLC",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "copy:model": "node scripts/copy-basic-pitch-model.mjs",
    "postinstall": "node scripts/copy-basic-pitch-model.mjs",
    "build": "npm run copy:model && vite build",
    "electron": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.cfunkycreations.lyricist",
    "productName": "Lyricist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/assets/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeaderIcon": "src/assets/icon.ico"
    }
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@spotify/basic-pitch": "^1.0.1",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3"
  }
}
