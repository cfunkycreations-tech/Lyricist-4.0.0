{
  "name": "lyricist",
  "version": "4.1.3",
  "main": "main.js",
  "description": "AI Songwriting Studio — Lyricist 4.1.3",
  "author": "CFunky Creations LLC",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.cfunkycreations.lyricist",
    "productName": "Lyricist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/assets/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeaderIcon": "src/assets/icon.ico"
    }
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.0.10"
  }
}
