{
  "name": "lyricist",
  "version": "4.2.0",
  "main": "main.js",
  "description": "AI Songwriting Studio \u2014 Lyricist 4.2.0 Goes Quantum",
  "author": "CFunky Creations LLC",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "copy:model": "node scripts/copy-basic-pitch-model.mjs",
    "postinstall": "node scripts/copy-basic-pitch-model.mjs && node scripts/copy-onnx-runtime.mjs && node scripts/fetch-ghost-voice-model.mjs",
    "build": "npm run copy:model && npm run copy:ort && npm run fetch:voice && vite build",
    "electron": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "node scripts/preflight.mjs && node scripts/release.mjs",
    "release:same": "node scripts/release.mjs --no-bump",
    "release:dir": "node scripts/release.mjs --dir",
    "preflight": "node scripts/preflight.mjs",
    "copy:ort": "node scripts/copy-onnx-runtime.mjs",
    "fetch:voice": "node scripts/fetch-ghost-voice-model.mjs"
  },
  "build": {
    "appId": "com.cfunkycreations.lyricist",
    "productName": "Lyricist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "demucsLocal.js",
      "comfySetup.js",
      "kaggleCloud.js",
      "splash/**/*",
      "src/assets/icon.ico",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/kaggle-minimax-music3.ipynb",
        "to": "kaggle-minimax-music3.ipynb"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerHeaderIcon": "src/assets/icon.ico",
      "shortcutName": "Lyricist"
    },
    "artifactName": "Lyricist ${version} Setup.${ext}"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@spotify/basic-pitch": "^1.0.1",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "spessasynth_core": "^4.3.17",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3"
  }
}
